[Unit]
Description=Let's Encrypt multi-certificate renewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cert-renewer
Group=cert-renewer
Environment=PYTHONPATH=/opt/cert-renewer/src
ExecStartPre=/usr/bin/python3 -m cert_renewer check --config /etc/cert-renewer/config.toml
ExecStart=/usr/bin/python3 -m cert_renewer run --config /etc/cert-renewer/config.toml
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/lib/cert-renewer -/etc/nginx/certs
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
